// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  staff
}

enum MovementType {
  in
  out
}

enum PurchaseOrderStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

enum PaymentMethod {
  cash
  promptpay
  card
}

enum SaleStatus {
  completed
  voided
}

enum ModifierSelectionType {
  single
  multiple
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String
  role                Role      @default(staff)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  homeLocationId      Int?
  createdAt           DateTime  @default(now())

  createdProducts       Product[]       @relation("ProductCreatedBy")
  stockMovements        StockMovement[] @relation("MovementCreatedBy")
  auditLogs             AuditLog[]
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  homeLocation          Location?       @relation(fields: [homeLocationId], references: [id])
  sales                 Sale[]          @relation("SaleCashier")
  voidedSales           Sale[]          @relation("SaleVoidedBy")

  @@map("users")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Product {
  id           Int       @id @default(autoincrement())
  sku          String    @unique
  barcode      String?   @unique
  name         String
  unit         String
  category     String?
  imageUrl     String?
  unitCost     Decimal?  @db.Decimal(12, 2)
  sellingPrice Decimal?  @db.Decimal(12, 2)
  quantity     Int       @default(0)
  reorderLevel Int       @default(0)
  supplierId   Int?
  createdById  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  createdBy          User                @relation("ProductCreatedBy", fields: [createdById], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  locationStock      LocationStock[]
  modifierGroups     ModifierGroup[]
  saleItems          SaleItem[]

  @@map("products")
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  productId   Int
  type        MovementType
  quantity    Int
  note        String?
  locationId  Int?
  createdById Int
  createdAt   DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])
  createdBy User      @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@map("stock_movements")
}

model Location {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  taxBranchCode  String?
  promptPayQrUrl String?
  createdAt      DateTime @default(now())

  stockMovements StockMovement[]
  homeStaff      User[]
  locationStock  LocationStock[]
  sales          Sale[]

  @@map("locations")
}

model LocationStock {
  id         Int      @id @default(autoincrement())
  productId  Int
  locationId Int
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("location_stock")
}

model ModifierGroup {
  id            Int                   @id @default(autoincrement())
  productId     Int
  name          String
  selectionType ModifierSelectionType
  required      Boolean               @default(false)
  sortOrder     Int                   @default(0)

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ModifierOption[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              Int     @id @default(autoincrement())
  modifierGroupId Int
  name            String
  priceDelta      Decimal @default(0) @db.Decimal(12, 2)
  sortOrder       Int     @default(0)

  modifierGroup ModifierGroup      @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  saleItemMods  SaleItemModifier[]

  @@map("modifier_options")
}

model Sale {
  id             Int           @id @default(autoincrement())
  locationId     Int
  cashierId      Int
  status         SaleStatus    @default(completed)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(6, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  taxInclusive   Boolean       @default(true)
  total          Decimal       @db.Decimal(12, 2)
  receiptNumber  String?       @unique
  paymentMethod  PaymentMethod
  amountTendered Decimal?      @db.Decimal(12, 2)
  changeDue      Decimal?      @db.Decimal(12, 2)
  note           String?
  voidedAt       DateTime?
  voidedById     Int?
  createdAt      DateTime      @default(now())

  location Location   @relation(fields: [locationId], references: [id])
  cashier  User       @relation("SaleCashier", fields: [cashierId], references: [id])
  voidedBy User?      @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  items    SaleItem[]

  @@map("sales")
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  productId   Int
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  sale      Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id])
  modifiers SaleItemModifier[]

  @@map("sale_items")
}

model SaleItemModifier {
  id               Int     @id @default(autoincrement())
  saleItemId       Int
  modifierOptionId Int?
  name             String
  priceDelta       Decimal @db.Decimal(12, 2)

  saleItem       SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@map("sale_item_modifiers")
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  supplierId  Int
  status      PurchaseOrderStatus @default(draft)
  notes       String?
  createdById Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  orderedAt   DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int      @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitCost         Decimal? @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  details    String?
  userId     Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

/// Single-row table (id is always 1) holding the shop-level details a Thai tax
/// invoice needs, plus how VAT is applied. Kept out of Location because the
/// legal entity and tax id are company-wide; only the branch code differs.
model ShopSetting {
  id               Int      @id @default(1)
  legalName        String?
  taxId            String?
  address          String?
  vatRegistered    Boolean  @default(false)
  vatRate          Decimal  @default(0.07) @db.Decimal(6, 4)
  pricesIncludeVat Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("shop_settings")
}
