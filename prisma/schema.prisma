// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  admin
  staff
}

enum MovementType {
  in
  out
}

enum PurchaseOrderStatus {
  draft
  ordered
  partially_received
  received
  cancelled
}

model User {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  passwordHash        String
  role                Role      @default(staff)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())

  createdProducts       Product[]       @relation("ProductCreatedBy")
  stockMovements        StockMovement[] @relation("MovementCreatedBy")
  auditLogs             AuditLog[]
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")

  @@map("users")
}

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Product {
  id           Int       @id @default(autoincrement())
  sku          String    @unique
  barcode      String?   @unique
  name         String
  unit         String
  category     String?
  imageUrl     String?
  unitCost     Float?
  quantity     Int       @default(0)
  reorderLevel Int       @default(0)
  supplierId   Int?
  createdById  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  createdBy          User                @relation("ProductCreatedBy", fields: [createdById], references: [id])
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("products")
}

model StockMovement {
  id          Int          @id @default(autoincrement())
  productId   Int
  type        MovementType
  quantity    Int
  note        String?
  locationId  Int?
  createdById Int
  createdAt   DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])
  createdBy User      @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@map("stock_movements")
}

model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  stockMovements StockMovement[]

  @@map("locations")
}

model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  supplierId  Int
  status      PurchaseOrderStatus @default(draft)
  notes       String?
  createdById Int
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  orderedAt   DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int   @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int
  quantityOrdered  Int
  quantityReceived Int   @default(0)
  unitCost         Float?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  details    String?
  userId     Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
