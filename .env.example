# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Required — the app refuses to start without it (it never falls back to a default database).
# The test suite uses a separate database; override it with TEST_DATABASE_URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sandsd01_dev"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000

# Used only by prisma/seed.js to create the initial admin user
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

# Optional: low-stock email alerts via Resend (https://resend.com).
# If RESEND_API_KEY or ALERT_EMAIL_TO is unset, alert emails are skipped (logged, not an error).
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="onboarding@resend.dev"

# Optional: cron schedule (server local time) for the daily inventory summary
# email. Defaults to 8am daily. Same Resend config as above is reused.
DAILY_SUMMARY_CRON="0 8 * * *"

# Base URL of the frontend, used to build the link in password reset emails.
APP_URL="http://localhost:5173"
