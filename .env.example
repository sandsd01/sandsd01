# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Required — the app refuses to start without it (it never falls back to a default database).
# The test suite uses a separate database; override it with TEST_DATABASE_URL.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/sandsd01_dev"
# Must be random and at least 32 characters — the server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000

# Set when running behind a load balancer/reverse proxy (Railway, Render, nginx…)
# so rate limiting sees the real client IP. Use the number of proxy hops (usually 1).
# Leave unset when the app is exposed directly — trusting X-Forwarded-For without a
# proxy in front lets clients spoof their IP and bypass rate limits.
# TRUST_PROXY=1

# Comma-separated allowed origins for CORS. Leave unset when the API also serves
# the built frontend (same origin). Required if the frontend is hosted separately.
# CORS_ORIGIN="https://pos.example.com"

# IANA timezone used for the daily summary cron. Defaults to Asia/Bangkok.
# CRON_TIMEZONE="Asia/Bangkok"

# Used only by prisma/seed.js to create the initial admin user
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

# Optional: low-stock email alerts via Resend (https://resend.com).
# If RESEND_API_KEY or ALERT_EMAIL_TO is unset, alert emails are skipped (logged, not an error).
RESEND_API_KEY=""
ALERT_EMAIL_TO=""
ALERT_EMAIL_FROM="onboarding@resend.dev"

# Optional: cron schedule (server local time) for the daily inventory summary
# email. Defaults to 8am daily. Same Resend config as above is reused.
DAILY_SUMMARY_CRON="0 8 * * *"

# Base URL of the frontend, used to build the link in password reset emails.
APP_URL="http://localhost:5173"

# Uploaded images (product photos, branch PromptPay QR codes).
# Unset = local disk (uploads/), which is fine for development but is lost on
# every redeploy on container hosting. Set S3_BUCKET + S3_PUBLIC_BASE_URL to use
# any S3-compatible object store (AWS S3, Cloudflare R2, MinIO, Spaces…).
# S3_BUCKET="pos-uploads"
# S3_PUBLIC_BASE_URL="https://cdn.example.com"   # public URL images are served from
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"  # omit for plain AWS S3
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
